# ──────────────────────────────────────────────
# Firebase Client (se expone al navegador)
# ──────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ──────────────────────────────────────────────
# Firebase Admin (SOLO servidor — nunca al cliente)
# La clave privada puede tener \n literales; el código los transforma en saltos de línea.
# Ejemplo: FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nABC...\n-----END PRIVATE KEY-----\n"
# ──────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ──────────────────────────────────────────────
# Código familiar — SHA-256 en hex del código (no el código en texto plano)
# Generar: node -e "process.stdout.write(require('crypto').createHash('sha256').update('TU_CODIGO').digest('hex'))"
# ──────────────────────────────────────────────
FAMILY_ACCESS_CODE_SHA256=

# ──────────────────────────────────────────────
# Correo del propietario (solo usado por el script bootstrap:owner)
# ──────────────────────────────────────────────
OWNER_EMAIL=

# ──────────────────────────────────────────────
# Backend API
# ──────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ──────────────────────────────────────────────
# Sesión
# ──────────────────────────────────────────────
SESSION_COOKIE_NAME=pixel_drop_session
SESSION_EXPIRES_IN_MS=432000000
